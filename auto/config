#!/bin/sh
set -eu

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --binary-image iso-hybrid \
    --bootloaders "syslinux grub-efi" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "https://deb.debian.org/debian/" \
    --mirror-chroot "https://deb.debian.org/debian/" \
    --mirror-chroot-security "https://security.debian.org/debian-security/" \
    --mirror-binary "https://deb.debian.org/debian/" \
    --mirror-binary-security "https://security.debian.org/debian-security/" \
    --apt-recommends false \
    --firmware-chroot true \
    --firmware-binary true \
    --debian-installer live \
    --debian-installer-distribution trixie \
    --debian-installer-gui true \
    --debian-installer-preseedfile preseed.cfg \
    --bootappend-install "" \
    --bootappend-live "boot=live components username=live hostname=aphrodite-os" \
    --bootappend-live-failsafe "boot=live components username=live hostname=aphrodite-os memtest noapic noapm nodma nomce nosmp nosplash vga=788" \
    --image-name "aphrodite-os-0" \
    --iso-application "Aphrodite OS 0 (infant)" \
    --iso-volume "aphrodite-os-0" \
    "${@}"
