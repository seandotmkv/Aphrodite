#!/bin/bash
set -euo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
if [ "${1:-check}" = install ]; then
    test "$(id -u)" -eq 0 || { echo 'Run sudo aphrodite-update install.' >&2; exit 1; }
    umask 077
    /usr/bin/python3 /usr/lib/aphrodite/releases.py "$@" 2>&1 | tee -a /var/log/aphrodite-update.log
else
    exec /usr/bin/python3 /usr/lib/aphrodite/releases.py "$@"
fi
