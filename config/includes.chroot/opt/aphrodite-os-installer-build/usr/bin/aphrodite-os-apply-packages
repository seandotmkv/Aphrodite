#!/usr/bin/python3
"""Apply or retry application choices on a separately mounted aphrodite-os target."""

import argparse
import json
import os
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib/calamares/modules/aphroditeprofiles"))
from executor import TransactionError, apply
from selection import validate


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("target", type=Path, help="Mounted root of an installed aphrodite-os system")
    parser.add_argument("plan", nargs="?", type=Path,
                        help="Selection JSON or a non-demo terminal plan. Defaults to the target's last selection.")
    args = parser.parse_args()
    if os.geteuid():
        parser.error("Run as root from the live environment")
    try:
        path = args.plan or args.target / "var/lib/aphrodite-os/selected-packages.json"
        with path.open() as stream:
            source = stream.read(32769)
        if len(source) > 32768:
            raise ValueError("Plan exceeds the maximum input size")
        value = json.loads(source)
        # Read previously exported selections without changing their contents.
        legacy_schemas = {'sean-os.terminal-setup/1': 'aphrodite-os.terminal-setup/1',
                          'sean-os.terminal-setup/2': 'aphrodite-os.terminal-setup/2'}
        if isinstance(value, dict) and value.get('schema') in legacy_schemas:
            value['schema'] = legacy_schemas[value['schema']]
        if isinstance(value, dict) and value.get("schema") == "aphrodite-os.terminal-setup/2":
            if value.get("demo") is not False:
                raise ValueError("Demo plans cannot be applied")
            value = value.get("packages")
            if not isinstance(value, dict):
                raise ValueError("Terminal plan is missing its package selection")
        elif isinstance(value, dict) and value.get("schema") == "aphrodite-os.terminal-setup/1":
            if value.get("demo") is not False:
                raise ValueError("Demo plans cannot be applied")
            legacy = value.get("packages", {})
            if not isinstance(legacy, dict) or legacy.get("additional_packages"):
                raise ValueError("Re-create the legacy custom app selections using the new terminal picker")
            value = legacy.get("profile")
            if not isinstance(value, str):
                raise ValueError("Legacy plan is missing its package profile")
        results = apply(args.target, validate(value), lambda line: print(line, flush=True))
    except (ValueError, OSError, TransactionError) as error:
        print(error, file=sys.stderr)
        return 2
    if any(" incomplete." in line or " skipped." in line or " skipped after " in line for line in results):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
