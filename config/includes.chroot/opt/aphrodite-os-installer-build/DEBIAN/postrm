#!/bin/sh
set -eu
if [ "$1" = purge ]; then
    for path in /etc/calamares/settings.conf /etc/calamares/modules/partition.conf \
        /etc/calamares/modules/keyboard.conf /etc/calamares/modules/users.conf \
        /etc/calamares/modules/welcome.conf; do
        if [ "$(dpkg-divert --listpackage "$path")" = aphrodite-os-live-installer ]; then
            dpkg-divert --package aphrodite-os-live-installer --rename --remove \
                --divert "$path.debian" "$path"
        fi
    done
fi
