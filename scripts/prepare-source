#!/usr/bin/env python3
"""Restore Unix script permissions and shell line endings after ZIP extraction."""
from pathlib import Path
import os

if os.name != 'posix':
    raise SystemExit('Run this with python3 in Debian/WSL, inside the extracted repository.')
root = Path(__file__).resolve().parents[1]
count = 0
for directory in ('auto', 'config', 'scripts', 'tests'):
    for path in (root / directory).rglob('*'):
        if path.is_symlink() or not path.is_file():
            continue
        if not path.resolve().is_relative_to(root):
            raise SystemExit('Source path leaves the repository: ' + str(path))
        with path.open('rb') as stream:
            prefix = stream.read(100)
        if prefix.startswith((b'#!/bin/sh', b'#!/bin/bash', b'#!/usr/bin/python3', b'#!/usr/bin/env python3')):
            data = path.read_bytes()
            if b'\r\n' in data:
                path.write_bytes(data.replace(b'\r\n', b'\n'))
            path.chmod(0o755)
            count += 1
print('Prepared', count, 'executable source files. No packages installed or ISO build started.')
